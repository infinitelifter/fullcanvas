# Copy to .env.local for local dev; set the same three in
# Vercel → Settings → Environment Variables for production.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where booking-form leads are delivered.
CONTACT_TO=you@example.com

# Verified sender. The domain here must be verified in Resend,
# otherwise Resend rejects the send.
CONTACT_FROM=Full Canvas <web@fullcanvas.cz>

# Origin of the Recepce demo app embedded on /demo. It runs as a separate
# FastAPI service on its own host (it needs a long-running process), so this
# is only the URL we iframe — nothing is proxied through Next.
# Optional: the code falls back to https://demo.fullcanvas.cz.
NEXT_PUBLIC_DEMO_URL=https://demo.fullcanvas.cz
