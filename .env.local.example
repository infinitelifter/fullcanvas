# Copy to .env.local for local dev; set the same three in
# Vercel → Settings → Environment Variables for production.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where booking-form leads are delivered.
CONTACT_TO=you@example.com

# Verified sender. The domain here must be verified in Resend,
# otherwise Resend rejects the send.
CONTACT_FROM=Full Canvas <web@fullcanvas.cz>
